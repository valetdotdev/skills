{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/prefer-valet-publish.py",
            "statusMessage": "Checking publish target"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/prefer-valet-publish.py"
          }
        ]
      }
    ]
  }
}
